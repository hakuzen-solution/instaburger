# ==========================================================================
# Variáveis de ambiente do FoodTruck Pedidos
# Copie este arquivo para ".env" (localmente) OU configure estas variáveis
# na aba "Variables" do serviço no Railway.
# ==========================================================================

# --- Banco de dados PostgreSQL ---------------------------------------------
# No Railway: adicione um plugin "PostgreSQL" ao projeto e use a variável
# de referência ${{Postgres.DATABASE_URL}} no serviço da aplicação.
# Localmente, informe a string de conexão completa:
DATABASE_URL="postgresql://usuario:senha@host:5432/nome_do_banco"

# --- Segredos de autenticação ---------------------------------------------
# Gere valores aleatórios e seguros. Ex.: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-valor-aleatorio-seguro"
AUTH_SECRET="troque-por-um-valor-aleatorio-seguro"

# --- URL pública da aplicação ---------------------------------------------
# Após o primeiro deploy, defina com o domínio gerado pelo Railway.
# Ex.: https://foodtruck-pedidos-production.up.railway.app
NEXTAUTH_URL="https://seu-app.up.railway.app"
